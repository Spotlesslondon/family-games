# Copy to .env.local for development. In Vercel these are project environment variables.
# Never paste a secret value into chat; enter it straight into Vercel.

# Supabase project URL. Not secret. Already set in Vercel.
SUPABASE_URL=https://vtriqairqssveayrwhzv.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://vtriqairqssveayrwhzv.supabase.co

# Supabase publishable key (sb_publishable_...). Not secret; used by phones
# for Realtime subscriptions and sign-in refresh.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Supabase secret key (sb_secret_...), Project Settings > API Keys.
# Server only. The legacy service_role key is not used.
SUPABASE_SECRET_KEY=

# SECRET. Derives each member's hidden Supabase Auth password:
# HMAC-SHA256(MEMBER_PASSWORD_KEY, auth user id). Generate with:
#   openssl rand -base64 32
# Changing it later requires resetting every member's Auth password.
MEMBER_PASSWORD_KEY=

# SECRET. Vercel sends it with cron requests. Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# Web Push (Phase 3). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
