# Copy to .env.local for development. In Vercel these are project environment variables.

# Supabase project (Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret used to sign member, screen and owner tokens that row level security reads.
# Must be the project's JWT secret so Supabase accepts the tokens.
SUPABASE_JWT_SECRET=

# Shared secret Vercel sends with cron requests. Any long random string.
CRON_SECRET=

# Web Push (Phase 3). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
